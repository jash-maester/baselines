# Build artifacts and runtime state — regenerable, don't commit
logs/
.venv/
**/__pycache__/
*.pyc

# Orchestrator state IS committed (autoresearch.json, matrix.json) for the
# operator audit trail, but per-attempt footprints are large/noisy.
state/footprints/*.footprint.json

# === Reproduction policy (added): commit CODE + recreation scripts ONLY ===
# Never commit weights, checkpoints, datasets, or anything needing git-lfs.
# Python env / caches
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ipynb_checkpoints/
.DS_Store
